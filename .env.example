# ============================================================
# FF Store - Environment Variables Template
# Copy file này thành .env và điền giá trị thật
# cp .env.example .env
# ============================================================

# --- JWT Secret Key (bắt buộc) ---
# Tạo key mới: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Admin Credentials ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- CORS Origins (domain website, phân tách bằng dấu phẩy) ---
ALLOWED_ORIGINS=https://your-domain.com

# --- ImgBB API Keys (phân tách bằng dấu phẩy, xoay vòng) ---
# Đăng ký tại: https://api.imgbb.com/
IMGBB_KEYS=

# --- Cloudinary ---
# Đăng ký tại: https://cloudinary.com/
CLOUDINARY_CLOUD=
CLOUDINARY_PRESET=

# --- Google Drive (Google Apps Script URL) ---
# Xem hướng dẫn: https://github.com/labnol/apps-script-starter
GAS_URL=

# --- Database (tùy chọn, mặc định dùng SQLite) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/ff_shop

# --- Reset DB (chỉ set "true" khi muốn xóa toàn bộ DB) ---
# RESET_DB=false
